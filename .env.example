# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your_key_here
# Reminders (web push): run `python -m backend.push keys` once and paste the two lines it prints.
# VAPID_SUBJECT is the site address, e.g. https://your-host. Leave empty to keep reminders off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Used only by the admin dashboard (live Pilot page and python -m eval_dashboard.pull_backup)
REMEM_SERVER_URL=
REMEM_ADMIN_USER=aryan
REMEM_ADMIN_PASSWORD=
